{
  "name": "@ursi-flow/runtime-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "start": "node server.mjs",
    "test": "node --test tests/bridge.test.mjs && node --import tsx --test tests/flow-model.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "sync:trajectory": "node scripts/sync-trajectory-viewer.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-virtual": "^3.14.26",
    "@xyflow/react": "^12.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "dompurify": "^3.4.18",
    "lucide-react": "0.468.0",
    "marked": "^15.0.12",
    "mermaid": "^11.17.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^9.1.0",
    "react-router": "^7.18.6",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/dagre": "^0.7.54",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.21.0",
    "typescript": "~5.7.3",
    "vite": "6.4.5"
  }
}
