{
  "name": "@ursi-flow/runtime-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "start": "node server.mjs",
    "test": "node --test tests/bridge.test.mjs && node --import tsx --test tests/flow-model.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.1",
    "dagre": "^0.8.5",
    "dompurify": "^3.4.18",
    "lucide-react": "0.468.0",
    "marked": "^15.0.12",
    "mermaid": "^11.17.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router": "^7.18.6"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/dagre": "^0.7.54",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "~5.7.3",
    "vite": "6.4.5"
  }
}
