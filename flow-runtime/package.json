{
  "name": "ursi-flow-runtime",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "FLOW.md 推进引擎、过程日志实体与日志文件存储",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "examples",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run"
  },
  "bundleDependencies": [
    "ursi-flow-core"
  ],
  "dependencies": {
    "ursi-flow-core": "file:../flow-core"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
