{
  "name": "ursi-flow-host",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Flow 运行宿主：daemon、CLI、MCP adapter 与本地/平台执行器",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./core": "./dist/core/index.js",
    "./mcp": "./dist/integrations/mcp/index.js"
  },
  "bin": {
    "ursi-flow-local": "dist/cli.js",
    "ursi-flowd": "dist/machine/daemon.js",
    "ursi-flow-executor-mcp": "dist/integrations/mcp/stdio.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --import tsx --test test/platform-daemon.test.mjs test/confirm-daemon.test.mjs test/local-pi.test.mjs && vitest run"
  },
  "bundleDependencies": [
    "ursi-executor-sdk"
  ],
  "dependencies": {
    "ursi-executor-sdk": "file:../executor-sdk",
    "ursi-flow-core": "file:../flow-core",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "proper-lockfile": "4.1.2",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/proper-lockfile": "4.1.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
