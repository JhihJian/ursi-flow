{
  "name": "@ursi/mcp-web",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": { "ursi-source": "./src/index.ts", "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./style.css": "./dist/style.css"
  },
  "files": ["dist", "src", "tailwind.config.cjs", "LICENSE.third-party"],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:standalone": "tsc --noEmit -p standalone/tsconfig.json && vite build --config standalone/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": { "react": "^19.0.0", "react-dom": "^19.0.0", "react-router": "^7.0.0" },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "react": "^19.3.1", "react-dom": "^19.3.1", "react-router": "^7.18.5",
    "@types/react": "^19.3.0", "@types/react-dom": "^19.3.0", "@types/node": "^24.0.0",
    "@testing-library/react": "^16.3.3", "@testing-library/user-event": "^14.6.12", "@testing-library/jest-dom": "^7.0.1",
    "jsdom": "^27.4.0", "tailwindcss": "^3.4.17", "typescript": "~5.7.3", "vite": "^6.4.5", "vitest": "^4.1.12"
  }
}
