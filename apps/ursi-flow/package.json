{
  "name": "ursi-flow",
  "version": "0.1.0",
  "private": false,
  "description": "FLOW.md 推进内核：无状态 SDK、运行引擎、执行器契约与命令行",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "ursi-flow": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./core/runtime": {
      "types": "./dist/core/runtime.d.ts",
      "default": "./dist/core/runtime.js"
    },
    "./executor": {
      "types": "./dist/executor/index.d.ts",
      "default": "./dist/executor/index.js"
    },
    "./executor/fake": {
      "types": "./dist/executor/adapters/fake.d.ts",
      "default": "./dist/executor/adapters/fake.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "SPEC.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs && vitest run",
    "test:pack": "node test/pack.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "yaml": "2.9.0"
  },
  "bundleDependencies": [
    "yaml"
  ],
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
