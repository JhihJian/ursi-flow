# 复制到 apps/web/.env.local，按需修改后重启开发服务或重新构建。
VITE_BRAND_NAME=ursi-flow
VITE_PROJECT_ID=ursi-flow
VITE_PROJECT_NAME=ursi-flow
VITE_PROJECT_DESCRIPTION=流程、工作项与执行记录
VITE_PROJECT_REPOSITORY=https://github.com/JhihJian/ursi-flow

# Workbench 独立部署的入口。留空时卡片显示未配置地址。
VITE_WORKBENCH_URL=
# 本地示例：VITE_WORKBENCH_URL=http://localhost:5173/work-items
