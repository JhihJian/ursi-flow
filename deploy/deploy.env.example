# 复制为 deploy/deploy.env 后按需修改；不要在这里写密钥。
# 唯一的数据与配置根目录，所有运行期写入都在它下面。
URSI_HOME=$HOME/.ursi
# 入口监听地址（Caddy）。默认 :8095，端口冲突时换成别的。
ENTRY_ADDR=:8095
# 后端监听地址。默认回环，只有刻意要把某个后端直接暴露时才改。
BACKEND_HOST=127.0.0.1
# 后端端口。与入口路由、单元和冒烟检查共用这一份取值。
TODO_PORT=8090
SSH_PORT=8091
FLOW_PORT=8094
PI_WEB_PORT=8093
FS_PORT=8199
# 可选：显式指定可执行文件，缺省从 PATH 取。
# NODE=/usr/local/bin/node
# CADDY=/usr/local/bin/caddy
# 清理策略：运行日志保留天数与 systemd 用户日志上限，deploy/prune.sh 使用。
RUNS_RETENTION_DAYS=30
JOURNAL_RETENTION_DAYS=14
JOURNAL_MAX_SIZE=512M
