[Unit]
Description=ursi-flow flow-web
After=network.target

[Service]
Type=simple
WorkingDirectory=@ROOT@/apps/flow-web/server
Environment=FLOW_WEB_HOST=@BACKEND_HOST@
Environment=FLOW_WEB_PORT=@FLOW_PORT@
Environment=FLOW_WEB_HOME=@URSI_HOME@/flow
Environment=FLOW_WEB_STATE=@URSI_HOME@/flow-web
ExecStart=@NODE@ src/main.ts
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
