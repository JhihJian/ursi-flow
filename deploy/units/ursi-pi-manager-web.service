[Unit]
Description=ursi-flow pi-manager-web
After=network.target

[Service]
Type=simple
WorkingDirectory=@ROOT@/apps/pi-manager-web/server
Environment=PI_MANAGER_HOST=@BACKEND_HOST@
Environment=PI_MANAGER_PORT=@PI_MANAGER_PORT@
Environment=PI_MANAGER_STATE=@URSI_HOME@/pi-manager/homes.json
ExecStart=@NODE@ src/server.ts
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
