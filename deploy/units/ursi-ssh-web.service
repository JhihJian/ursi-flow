[Unit]
Description=ursi-flow ssh-web
After=network.target

[Service]
Type=simple
WorkingDirectory=@ROOT@/apps/ssh-web
Environment=PORT=8091
Environment=HOST=127.0.0.1
Environment=SSH_WEB_STATIC_DIR=@ROOT@/apps/ssh-web/web/dist
ExecStart=@ROOT@/apps/ssh-web/target/release/ssh-web-server
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
