[Unit]
Description=ursi-flow ssh-web
After=network.target

[Service]
Type=simple
WorkingDirectory=@ROOT@/apps/ssh-web
Environment=PORT=@SSH_PORT@
Environment=HOST=@BACKEND_HOST@
Environment=URSI_DATA_DIR=@URSI_HOME@
Environment=SSH_WEB_STATIC_DIR=@ROOT@/apps/ssh-web/web/dist
ExecStart=@ROOT@/apps/ssh-web/target/release/ssh-web-server
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
