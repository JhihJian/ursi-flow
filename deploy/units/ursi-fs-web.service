[Unit]
Description=ursi-flow fs-web
After=network.target

[Service]
Type=simple
WorkingDirectory=@ROOT@
Environment=FS_WEB_HOST=@BACKEND_HOST@
Environment=FS_WEB_PORT=@FS_PORT@
Environment=FS_WEB_STATE=@URSI_HOME@/fs-web/workspaces.json
Environment=SSH_WEB_API=http://@BACKEND_HOST@:@SSH_PORT@/api
ExecStart=@NODE@ apps/fs-web/server/src/server.ts
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
