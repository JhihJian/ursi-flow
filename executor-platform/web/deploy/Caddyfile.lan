{
	admin off
	auto_https disable_redirects
	skip_install_trust
}

{$URSI_EXECUTOR_LAN_ORIGIN} {
	bind 0.0.0.0
	tls internal

	@outside not remote_ip {$URSI_EXECUTOR_LAN_CIDR}
	@platform path /api/v2/agent-options /api/v2/agent-backends /api/v2/agent-backends/* /api/v2/executors /api/v2/executors/* /api/v2/resources /api/v2/resources/* /api/v2/patches/config /api/v2/patches/config/* /api/v2/directories /api/v2/directories/* /api/v2/executor-attempts/*
	route {
		respond @outside 403
		handle @platform {
			@foreign_origin {
				header Origin *
				not header Origin {$URSI_EXECUTOR_LAN_ORIGIN}
			}
			@write_without_origin {
				not method GET HEAD
				not header Origin {$URSI_EXECUTOR_LAN_ORIGIN}
			}
			@console {
				header X-Ursi-Lan-Preview 1
				header Sec-Fetch-Site same-origin
			}
			route {
				header Cache-Control no-store
				respond @foreign_origin 403
				respond @write_without_origin 403
				reverse_proxy @console 127.0.0.1:{$URSI_EXECUTOR_LAN_API_PORT} {
					header_up -X-Ursi-Lan-Preview
					header_up Authorization "Bearer {env.URSI_EXECUTOR_PLATFORM_ADMIN_TOKEN}"
				}
				respond 403
			}
		}
		handle /api/* {
			respond 404
		}
		handle /assets/* {
			root * {$URSI_EXECUTOR_LAN_WEB_ROOT}
			file_server
		}
		handle {
			header Cache-Control no-cache
			root * {$URSI_EXECUTOR_LAN_WEB_ROOT}
			try_files {path} /index.html
			file_server
		}
	}
}
