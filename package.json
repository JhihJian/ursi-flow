{
  "name": "ursi-flow-ui",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/fs-web/web",
    "apps/ursi-sandbox/web",
    "apps/todo-web/web",
    "apps/dae-web/web",
    "apps/shell-web",
    "apps/ssh-web/web",
    "packages/workspace-shell",
    "apps/flow-web/web",
    "apps/flow-web/server",
    "apps/pi-web/server",
    "apps/pi-web/web",
    "packages/directory-picker",
    "packages/location"
  ],
  "scripts": {
    "test": "npm run test:location && node --test apps/fs-web/server/test/*.test.ts",
    "test:directory-picker": "npm run test -w @ursi/directory-picker",
    "test:todo-web": "npm run test -w @ursi/todo-web",
    "dev:shell-web": "npm run dev -w @ursi/shell-web",
    "build:shell-web": "npm run build -w @ursi/shell-web",
    "test:ursi-flow": "cd apps/ursi-flow && npm test",
    "build:ursi-flow": "cd apps/ursi-flow && npm run build",
    "test:flow-web": "npm run test -w @ursi/flow-web && npm run test -w @ursi/flow-web-server",
    "build:flow-web": "npm run build -w @ursi/flow-web",
    "test:pi-web": "npm run test -w @ursi/pi-web-server && npm run test -w @ursi/pi-web",
    "build:pi-web": "npm run build -w @ursi/pi-web",
    "test:location": "npm run test -w @ursi/location"
  }
}
