{
  "name": "ursi-flow-ui",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/web",
    "fs-web/web",
    "shell-web",
    "packages/ui-layout",
    "packages/ui-slots",
    "packages/workspace-shell"
  ],
  "scripts": {
    "dev": "npm run dev -w @ursi/portal-web",
    "build": "npm run build -w @ursi/portal-web",
    "portal:check-config": "node apps/web/scripts/check-config.ts",
    "test": "node --test packages/ui-slots/test/*.test.ts apps/web/test/*.test.ts fs-web/server/test/*.test.ts",
    "test:e2e": "npm run test:e2e -w @ursi/portal-web",
    "dev:shell-web": "npm run dev -w @ursi/shell-web",
    "build:shell-web": "npm run build -w @ursi/shell-web"
  }
}
